{
  "rules": {
    "zargos_lords": {
      "stanze": {
        "$stanza": {
          ".read": "auth != null",
          ".write": "auth != null",
          "version": { ".validate": "newData.isNumber() && newData.val() == 2" },
          "revision": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$altro": { ".validate": true }
        }
      }
    }
  }
}
