extends SceneTree

func _init() -> void:
	assert(ZargosRules.hex_distance(Vector2i(0, 0), Vector2i(0, 0)) == 0)
	assert(ZargosRules.hex_distance(Vector2i(3, 3), Vector2i(4, 3)) == 1)
	assert(ZargosRules.terrain_cost(ZargosRules.Terrain.FOREST) == 2)
	assert(ZargosRules.terrain_cost(ZargosRules.Terrain.SEA) == -1)
	assert(ZargosRules.terrain_cost(ZargosRules.Terrain.VOID) == -1)
	assert(ZargosRules.defense_bonus(ZargosRules.Terrain.MOUNTAIN) == 3)
	assert(ZargosRules.resolve_combat(12, 5, 4).result == "D3")
	assert(ZargosRules.resolve_combat(10, 5, 6).result == "DE")
	assert(ZargosRules.resolve_combat(2, 7, 1).result == "AE")
	assert(ZargosRules.arrow_hits(6, 8) == 1)
	assert(ZargosRules.arrow_hits(1, 4) == 0)
	assert(ZargosRules.fire_hits(4, 5) == 1)
	assert(ZargosRules.fire_hits(4, 5, true) == 2)
	assert(ZargosRules.vision_retreat(1, 1, 7) == 5)
	assert(ZargosRules.vision_retreat(6, 1, 7) == 7)
	assert(ZargosRules.arrow_hits(5, 1) == 3)
	assert(ZargosRules.fire_hits(6, 1) == 4)
	var state := ZargosGameState.new()
	for i in range(3): state.advance_phase()
	assert(state.active_faction() == &"Draghi")
	state.register_city(&"Cavalieri")
	state.capture_city(&"Cavalieri", &"Draghi")
	assert(state.cities[&"Cavalieri"] == 0)
	assert(state.cities[&"Draghi"] == 1)
	var duel := ZargosGameState.new()
	duel.configure([&"Monaci", &"Alati"])
	assert(duel.active_faction() == &"Monaci")
	for i in range(3): duel.advance_phase()
	assert(duel.active_faction() == &"Alati")
	for i in range(3): duel.advance_phase()
	assert(duel.month == 2)
	var board := ZargosBoardData.new()
	assert(board.terrain_at(Vector2i(20, 9)) == ZargosRules.Terrain.FOREST)
	assert(board.terrain_at(Vector2i(3, 7)) == ZargosRules.Terrain.MOUNTAIN)
	assert(board.terrain_at(Vector2i(8, 18)) == ZargosRules.Terrain.MAGIC_VORTEX)
	assert(board.terrain_at(Vector2i(18, 0)) == ZargosRules.Terrain.VOID)
	board.set_terrain(Vector2i(2, 4), ZargosRules.Terrain.FOREST)
	board.set_terrain(Vector2i(8, 0), ZargosRules.Terrain.SEA)
	board.set_terrain(Vector2i(6, 3), ZargosRules.Terrain.MOUNTAIN)
	assert(board.find_movement_cost(Vector2i(1, 4), Vector2i(2, 4), 4, false, func(_hex): return false) == 2)
	assert(board.find_movement_cost(Vector2i(7, 0), Vector2i(8, 0), 4, false, func(_hex): return false) == -1)
	assert(board.find_movement_cost(Vector2i(5, 3), Vector2i(6, 3), 5, false, func(_hex): return false) == 5)
	assert(board.find_movement_cost(Vector2i(7, 0), Vector2i(8, 0), 4, true, func(_hex): return false) == -1)
	var blocked := board.reachable_hexes(Vector2i(1, 1), 3, false, func(hex): return hex == Vector2i(2, 1))
	assert(not blocked.has(Vector2i(2, 1)))
	var zoc_stop := board.reachable_hexes(Vector2i(1, 1), 3, false, func(_hex): return false, func(hex): return ZargosRules.hex_distance(Vector2i(1, 1), hex) == 1)
	assert(zoc_stop.has(Vector2i(2, 1)))
	assert(not zoc_stop.has(Vector2i(3, 1)))
	print("ZargosRules: tutti i test superati")
	quit()
